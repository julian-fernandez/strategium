// The hosted site on Cloudflare (`pnpm deploy:site`): the built web app and its
// data (`pnpm build:site`) as static files, and worker/index.ts for the API.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strategium",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // The site lives at its workers.dev address only: no extra preview link per deploy.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
